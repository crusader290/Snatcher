+static uint64_t vint_clock_for_line(uint64_t line)
+{
+    uint64_t master=line*3420u+SEGACD_VINT_DELAY_MCLK;
+    return master/53693175u*12500000u+((master%53693175u)*12500000u+53693174u)/53693175u;
