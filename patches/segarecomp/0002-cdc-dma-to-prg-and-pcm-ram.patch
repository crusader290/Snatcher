 /* Move `length` bytes (whole words; an odd last byte is not transferred) from the CDC buffer to the latched destination. A
  * destination of the other Word RAM mode than the current one is not the live memory (GPGX keeps separate 2M and bank buffers and
  * copies only on a mode switch): those writes are lost. */
+/* Destination 5 (PRG RAM): word writes at (register x 8), honouring the write protect like a sub write; the register advances one unit
+ * per 8 bytes. Destination 4 (PCM RAM): the current wave bank at (register x 4) & $FFF; each CDC word stores its second byte at the even
+ * and its first byte at the odd address; the register advances one unit per 4 bytes. (ares mcd cdc-transfer, GPGX cdc.c semantics.) */
+static void scd_cdc_dma_move_prg_pcm(ScdMachine *m, uint32_t words) {
+  uint32_t src = m->cdc.dac & 0x3FFEU, i;
+  if (m->cdc.dma_target == SCD_DMA_TARGET_PRG) {
+    uint32_t dst = ((uint32_t)m->cdc.dma_address << 3) & (SCD_PRG_RAM_BYTES - 1U) & ~1U;
+    const uint32_t protect = (uint32_t)m->ga.write_protect * UINT32_C(0x200);
+    m->cdc.dma_address = (uint16_t)(m->cdc.dma_address + (words >> 2));
+    for (i = 0; i < words; ++i) {
+      if (dst < protect) {
+        ++m->prg_write_protect_drops;
+      } else {
+        m->prg_ram[dst] = m->cdc.buffer[src];
+        m->prg_ram[dst + 1U] = m->cdc.buffer[src + 1U];
+        SCD_OVERLAY_NOTE_WRITE(m, SCD_MEMORY_PRG, dst, 2U);
+      }
+      src = (src + 2U) & 0x3FFEU;
+      dst = (dst + 2U) & (SCD_PRG_RAM_BYTES - 1U);
+    }
+  } else {
+    const uint32_t bank = ((uint32_t)m->pcm.bank & 0x0FU) << 12;
+    uint32_t dst = ((uint32_t)m->cdc.dma_address << 2) & 0x0FFEU;
+    m->cdc.dma_address = (uint16_t)(m->cdc.dma_address + (words >> 1));
+    for (i = 0; i < words; ++i) {
+      m->pcm.ram[bank | dst] = m->cdc.buffer[src + 1U];
+      m->pcm.ram[bank | (dst + 1U)] = m->cdc.buffer[src];
+      src = (src + 2U) & 0x3FFEU;
+      dst = (dst + 2U) & 0x0FFEU;
+    }
+  }
+  m->cdc.dac = (uint16_t)(m->cdc.dac + (words << 1));
+  m->cdc.dma_done += words << 1;
+}
