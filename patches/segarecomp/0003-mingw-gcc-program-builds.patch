+    def stack_link_flags(self):
+        """GCC on Windows (MinGW, GNU ld) has no #pragma comment(linker): reserve the 8 MiB main-thread stack at link time instead."""
+        if os.name != "nt":
+            return []
+        if not hasattr(self, "_stack_flags"):
+            version = subprocess.run([self.args.cc, "--version"], capture_output=True, text=True)
+            text = (version.stdout or "") + (version.stderr or "")
+            self._stack_flags = ["-Wl,--stack,8388608"] if ("gcc" in text.lower() and "clang" not in text.lower()) else []
+        return self._stack_flags
+
     def runtime_objects(self):
