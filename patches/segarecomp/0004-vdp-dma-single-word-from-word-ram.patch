+/* A one-word DMA from Word RAM: the source data arrives one bus cycle late, so only the stale bus word is left and it is not written
+ * (GPGX writes nothing); the destination still advances by the auto-increment and the transfer ends. The length counter reads 0 and the
+ * source address has moved one word, as after any transfer. The caller rewrites the command's address and clears its DMA bit (lag 2). */
+static void scd_vdp_dma_word_ram_single(uint16_t *r, uint32_t *word_ram_lag) {
+  const uint32_t low = (uint32_t)(r[21] & 0xFFU) + 1U;
+  r[19] = 0U;
+  r[20] = 0U;
+  r[21] = (uint16_t)(low & 0xFFU);
+  if (low > 0xFFU) r[22] = (uint16_t)((r[22] + 1U) & 0xFFU);
+  *word_ram_lag = 2U;
+}
